    "ApiValue": {
      "oneOf": [
        {
          "type": [
            "null",
            "string",
            "boolean",
            "number"
          ]
        },
        {
          "type": "array",
          "items": {
            "description": "Nested API values are validated at runtime, with a maximum nesting depth of 16."
          },
          "maxItems": 16384
        },
        {
          "$ref": "#/$defs/ApiStepReference"
        },
        {
          "$ref": "#/$defs/ApiDocumentReference"
        },
        {
          "$ref": "#/$defs/ApiObjectReference"
        },
        {
          "type": "object",
          "properties": {
            "$enum": {
              "oneOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "minItems": 1
                }
              ]
            }
          },
          "required": [
            "$enum"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "$missing": {
              "const": true
            }
          },
          "required": [
            "$missing"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "$array": {
              "enum": [
                "double",
                "int",
                "long",
                "short",
                "byte",
                "bool",
                "string",
                "object",
                "dispatch"
              ]
            },
            "items": {
              "type": "array",
              "items": {
                "description": "Nested API values are validated at runtime."
              },
              "maxItems": 16384
            }
          },
          "required": [
            "$array",
            "items"
          ],
          "additionalProperties": false
        }
      ]
    },
    "ApiStep": {
      "type": "object",
